# dev environment template (non-secret values only)
# Copy to the repo root as `.env` for local development, or export directly.

# Shared (all Python services)
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_PORT=8000

# Gateway
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
JWT_SECRET=dev-only-jwt-secret-change-in-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# AI OS Bridge
AIOS_BASE_URL=http://localhost:8100
AIOS_TIMEOUT_SECONDS=10.0
AIOS_MAX_RETRIES=5

# Databases (Phase 4 wires real connections; M3 reports not_configured)
# DATABASE_URL=postgresql+asyncpg://atoz:atoz@localhost:5432/atoz
# REDIS_URL=redis://localhost:6379/0
