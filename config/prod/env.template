# Production environment template (M11 Phase B, ADR-0012).
# Non-secret values only. Secrets (marked "Vault") are injected by the
# deployment pipeline from the secrets vault — never committed, never in
# compose. Every ${VAR:?...} referenced by infra/docker/compose.prod.yml
# must be documented here (enforced by tools/dev/check-infra.sh).

APP_ENV=prod
APP_LOG_LEVEL=INFO

# ---- Edge / domains ---------------------------------------------------------
SITE_DOMAIN=atozproducthub.dev
API_DOMAIN=api.atozproducthub.dev
ADMIN_DOMAIN=admin.atozproducthub.dev
PUBLIC_BASE_URL=https://atozproducthub.dev
CORS_ORIGINS=["https://atozproducthub.dev","https://www.atozproducthub.dev"]

# ---- Gateway -----------------------------------------------------------------
# JWT_SECRET — Vault: gateway signing/verification secret.
GATEWAY_JWT_SECRET=CHANGE_ME
# JWT_SECRET — Vault: per-service verification secrets.
CONTENT_JWT_SECRET=CHANGE_ME
AFFILIATE_JWT_SECRET=CHANGE_ME
PINTEREST_JWT_SECRET=CHANGE_ME
SEO_JWT_SECRET=CHANGE_ME
ANALYTICS_JWT_SECRET=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
AUTOMATION_JWT_SECRET=CHANGE_ME

# ---- Databases ---------------------------------------------------------------
# DATABASE_URL — Vault: postgresql+asyncpg://user:password@postgres:5432/atoz
DATABASE_URL=CHANGE_ME
POSTGRES_DB=atoz
POSTGRES_USER=atoz
POSTGRES_PASSWORD=CHANGE_ME

# ---- AI OS Bridge --------------------------------------------------------------
# AIOS_API_KEY — Vault: credential for the external Universal AI Content OS.
AIOS_BASE_URL=https://aios.internal.atozproducthub.dev
AIOS_API_KEY=CHANGE_ME
# AIOS_BRIDGE_INTERNAL_TOKEN — Vault: shared secret for business-layer
# service accounts (automation executor dispatch).
AIOS_BRIDGE_INTERNAL_TOKEN=CHANGE_ME
AIOS_CALLBACK_URL=http://aios-bridge:8000/bridge/jobs/status

# ---- Affiliate ------------------------------------------------------------------
# AFFILIATE_TOKEN_SIGNING_SECRET — Vault: HMAC key for signed redirect tokens.
AFFILIATE_TOKEN_SIGNING_SECRET=CHANGE_ME
# Per-network webhook secrets (JSON object; Vault).
AFFILIATE_WEBHOOK_SECRETS={}

# ---- Pinterest -------------------------------------------------------------------
# OAuth client credentials — Vault (per Pinterest app, least scope).
PINTEREST_OAUTH_CLIENT_ID=CHANGE_ME
PINTEREST_OAUTH_CLIENT_SECRET_REF=vault://pinterest/oauth/client-secret
PINTEREST_OAUTH_STATE_SECRET=CHANGE_ME
PINTEREST_OAUTH_REDIRECT_URI=https://admin.atozproducthub.dev/pinterest/oauth/callback

# ---- SEO --------------------------------------------------------------------------
# SEO_EVENT_SECRET — Vault: internal event-ingestion HMAC secret.
SEO_EVENT_SECRET=CHANGE_ME
# TYPESENSE_API_KEY — Vault: Typesense admin key.
TYPESENSE_API_KEY=CHANGE_ME

# ---- Analytics ---------------------------------------------------------------------
# ANALYTICS_EVENT_SECRET — Vault: internal event-ingestion HMAC secret.
ANALYTICS_EVENT_SECRET=CHANGE_ME

# ---- Admin ---------------------------------------------------------------------------
# ADMIN_EVENT_SECRET — Vault: internal event-ingestion HMAC secret.
ADMIN_EVENT_SECRET=CHANGE_ME
# ADMIN_INTERNAL_TOKEN — Vault: shared secret for service-account endpoints.
ADMIN_INTERNAL_TOKEN=CHANGE_ME

# ---- Observability (Phase D; collector added then) ------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces

# ---- Kafka ----------------------------------------------------------------------------
KAFKA_CLUSTER_ID=aatoz-kafka-cluster-2026
