# staging environment template (non-secret values only)
# Values are injected by the deployment pipeline; secrets live in Vault.

APP_ENV=staging
APP_LOG_LEVEL=INFO

# Gateway
CORS_ORIGINS=["https://staging.atozproducthub.dev"]
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# AI OS Bridge
AIOS_BASE_URL=https://aios.staging.internal
AIOS_TIMEOUT_SECONDS=10.0
AIOS_MAX_RETRIES=5

# Databases
DATABASE_URL=postgresql+asyncpg://atoz:CHANGE_ME@postgres:5432/atoz
REDIS_URL=redis://redis:6379/0
