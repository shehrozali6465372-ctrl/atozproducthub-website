{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atozproducthub.dev/contracts/aios/analytics-insights.v1.json",
  "title": "AIOS.Analytics.Insights",
  "description": "AI OS returns insights/recommendations over website-provided metrics; the website displays them read-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "niche_id", "period", "insight_bundle"],
  "properties": {
    "job_id": { "type": "string", "format": "uuid", "description": "Correlation" },
    "niche_id": { "type": "string", "format": "uuid", "description": "Scope" },
    "period": { "type": "string", "description": "Covered period" },
    "insight_bundle": {
      "type": "object",
      "description": "Headlines, findings, recommendations (display-only)",
      "additionalProperties": true
    },
    "display_flags": {
      "type": "object",
      "description": "How the dashboard may render it (no executable actions)",
      "additionalProperties": true
    }
  }
}
