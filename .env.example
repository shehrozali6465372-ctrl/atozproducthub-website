# AtozProductHub — environment template (M1 foundation)
# Copy to .env for local development. Never commit real values.

# Application
APP_ENV=dev                # dev | staging | prod | test
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Reserved connection settings (used by later phases)
DATABASE_URL=postgresql+psycopg://atoz:atoz@localhost:5432/atoz
REDIS_URL=redis://localhost:6379/0
