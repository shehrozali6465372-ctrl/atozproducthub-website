{
  "name": "atozproducthub-website",
  "version": "0.5.0",
  "private": true,
  "description": "AtozProductHub website \u2014 business layer only (monorepo root: dev tooling only).",
  "workspaces": [
    "apps/*",
    "libs/design-system"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @atoz/web",
    "dev:admin": "npm run dev --workspace @atoz/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
